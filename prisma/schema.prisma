generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DominantFoot {
  LEFT
  RIGHT
  BOTH
}

enum PlayerStatus {
  DRAFT
  PENDING_PARENT_INFO
  SUBMITTED
  PENDING_APPROVAL
  PENDING_REGISTRATION_PAYMENT
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum GuardianRelationship {
  MOTHER
  FATHER
  GUARDIAN
  OTHER
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  ONLINE_GATEWAY
  OTHER
}

enum PaymentStatus {
  COMPLETED
  REVERSED
  VOIDED
}

enum AdjustmentType {
  DISCOUNT
  SCHOLARSHIP
  WRITE_OFF
  CORRECTION
}

enum CoachAssignmentRole {
  PRIMARY
  ASSISTANT
}

enum StaffRole {
  COACH
  KITMAN
  RECEPTIONIST_CASHIER
  MEDIA
}

enum TrainingApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum TrainingSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  INJURED
}

enum RatingScaleType {
  SCALE_1_5
  SCALE_1_10
  QUALITATIVE
}

enum AssessmentCategory {
  TECHNICAL
  TACTICAL
  PHYSICAL
  MENTAL_BEHAVIOURAL
}

enum MatchStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  POSTPONED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum DocumentOwnerType {
  PLAYER
  GUARDIAN
  COACH
  PRODUCT
}

enum DocumentType {
  PHOTO
  BIRTH_CERTIFICATE
  MEDICAL_RECORD
  IDENTIFICATION
  QUALIFICATION
  OTHER
}

// ============================================================
// Identity & Security
// ============================================================

model User {
  id                 String     @id @default(uuid())
  academyId          String     @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  email              String
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  refreshTokenHash   String?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  academy                    Academy              @relation(fields: [academyId], references: [id])
  roles                      UserRole[]
  coachProfile               Coach?
  guardianProfile            Guardian?
  notifications              Notification[]
  auditLogs                  AuditLog[]
  uploadedDocuments          Document[]
  submittedFeedback          CoachFeedback[]
  passwordResetTokens        PasswordResetToken[]
  recordedAttendance         TrainingAttendance[] @relation("TrainingAttendanceRecorder")
  submittedIssues            ParentIssue[]        @relation("IssueSubmitter")
  issueMessages              IssueMessage[]       @relation("IssueMessageAuthor")
  submittedMerchandiseOrders MerchandiseOrder[]   @relation("MerchandiseOrderSubmitter")
  uploadedGalleryPhotos      GalleryPhoto[]

  @@unique([academyId, email])
  @@index([status])
  @@index([academyId])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  academyId String    @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  academy Academy @relation(fields: [academyId], references: [id])
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([academyId])
  @@map("password_reset_tokens")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  academyId String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  userId    String
  roleId    String
  grantedAt DateTime @default(now())

  academy Academy @relation(fields: [academyId], references: [id])
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([academyId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// Tenancy
// ============================================================
//
// `Academy` is the top-level tenant boundary for the whole platform — every
// other domain model (players, staff, finance, training, etc.) will carry an
// `academyId` foreign key back to this table so that one deployment can serve
// many independent football academies with fully isolated data. This is a
// distinct, higher dimension than `branchId` (seen below on Season/AgeCategory/
// Team) — that field is reserved for future *intra-academy* branches (multiple
// physical locations of the *same* academy) and must not be conflated with the
// tenant boundary modeled here.
//
// `academyId` is required on every tenant-scoped model, and the four
// identifiers that would otherwise collide across academies (User.email,
// AgeCategory.code, Player.playerCode, ConfigurationSetting.key) are unique
// per-academy rather than globally — see the `@@unique([academyId, ...])`
// constraint on each of those models.

enum AcademyStatus {
  ACTIVE
  SUSPENDED
  PENDING
  // Billing-driven, distinct from an admin's manual SUSPENDED: set by
  // BillingService when a subscription period lapses unpaid, and only ever
  // cleared back to ACTIVE by a successful payment — never by anything that
  // clears a manual SUSPENDED. Blocked identically to SUSPENDED by
  // TenantResolutionMiddleware.
  PAST_DUE
}

model Academy {
  id        String        @id @default(uuid())
  slug      String        @unique
  name      String
  status    AcademyStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  users                     User[]
  passwordResetTokens       PasswordResetToken[]
  userRoles                 UserRole[]
  seasons                   Season[]
  ageCategories             AgeCategory[]
  teams                     Team[]
  trainingGroups            TrainingGroup[]
  players                   Player[]
  guardians                 Guardian[]
  playerGuardians           PlayerGuardian[]
  playerRegistrations       PlayerRegistration[]
  playerGroupAssignments    PlayerGroupAssignment[]
  feeTypes                  FeeType[]
  feeItems                  FeeItem[]
  feeTypeItems              FeeTypeItem[]
  feeStructures             FeeStructure[]
  invoices                  Invoice[]
  payments                  Payment[]
  paymentAllocations        PaymentAllocation[]
  financialAdjustments      FinancialAdjustment[]
  coaches                   Coach[]
  coachAssignments          CoachAssignment[]
  coachQualifications       CoachQualification[]
  trainingPlans             TrainingPlan[]
  trainingActivities        TrainingActivity[]
  trainingActivityMarks     TrainingActivityMark[]
  trainingApprovals         TrainingApproval[]
  trainingSessions          TrainingSession[]
  playerOfTheWeekAwards     PlayerOfTheWeek[]
  galleryPhotos             GalleryPhoto[]
  trainingSessionActivities TrainingSessionActivity[]
  trainingAttendance        TrainingAttendance[]
  assessmentTemplates       AssessmentTemplate[]
  assessmentCriteria        AssessmentCriteria[]
  playerAssessments         PlayerAssessment[]
  assessmentRatings         AssessmentRating[]
  coachRemarks              CoachRemark[]
  opponents                 Opponent[]
  matches                   Match[]
  matchParticipations       MatchParticipation[]
  matchPlayerAssessments    MatchPlayerAssessment[]
  coachFeedback             CoachFeedback[]
  coachFeedbackCriteria     CoachFeedbackCriteria[]
  parentIssues              ParentIssue[]
  issueMessages             IssueMessage[]
  products                  Product[]
  productImages             ProductImage[]
  productVariants           ProductVariant[]
  merchandiseOrders         MerchandiseOrder[]
  merchandiseOrderItems     MerchandiseOrderItem[]
  notifications             Notification[]
  auditLogs                 AuditLog[]
  documents                 Document[]
  configurationSettings     ConfigurationSetting[]
  publicInquiries           PublicInquiry[]
  settings                  AcademySettings?
  subscription              AcademySubscription?
  trainingScheduleSlots     TrainingScheduleSlot[]

  @@map("academies")
}

// Per-academy configuration for third-party integrations and branding — each
// academy brings its own Paystack account, SMS sender, and email account (see
// the Tenancy note above: no shared merchant/sender across academies), plus
// the display name/logo used in its own emails, SMS, and receipts.
//
// SECURITY NOTE: paystackSecretKey, smsApiKey, and emailAppPassword are live
// third-party credentials stored in plaintext here. This is a known, called-out
// gap — encrypting these at rest (or moving them to a KMS-backed secret store)
// is a near-term follow-up, not something this migration resolves.
//
// Not a tenant-scoped model in the RLS sense (see TENANT_SCOPED_MODELS): its
// primary key already *is* the academy id, so every lookup is inherently
// scoped by whichever academyId the caller resolved from TenantContextService
// — there's no separate dimension for a policy to enforce.
model AcademySettings {
  academyId         String   @id
  paystackSecretKey String?
  paystackPublicKey String?
  paystackCurrency  String   @default("GHS")
  smsApiKey         String?
  smsSenderId       String?
  emailUser         String?
  emailAppPassword  String?
  brandName         String
  logoUrl           String?
  // Public-facing contact details — deliberately separate from emailUser
  // above (that's the Gmail account used to *send* mail, whose password is
  // tied to it) so an admin can edit what parents see without any risk of
  // breaking outbound email. Shown on the academy's own public page and login
  // screen; getPublicBranding() falls back to emailUser if this is unset, for
  // academies configured before this field existed.
  contactEmail      String?
  contactPhone      String?
  // Public-facing "where do you train" shown on the marketing page/login screen —
  // independent of the recurring schedule below, which can now have several slots
  // that each carry their own location.
  trainingLocation  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  @@map("academy_settings")
}

// The academy's recurring weekly training fixture(s) — an academy can train more than
// once a week (e.g. Tuesday evenings AND Saturday mornings), so this is a list rather
// than a single day/time on AcademySettings. Head Coach/Admin-editable; each slot drives
// both the auto-provisioning cron and the lazy get-or-create paths in TrainingService,
// so adding/editing/removing a slot reschedules that fixture for every active team.
model TrainingScheduleSlot {
  id        String   @id @default(uuid())
  academyId String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  dayOfWeek Int // 0 = Sunday .. 6 = Saturday
  startTime String
  endTime   String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id])

  @@index([academyId])
  @@map("training_schedule_slots")
}

// SAMS's own price list — not per-academy. A single mutable row: changing it
// only affects invoices generated after the change, since every invoice
// snapshots the price that was in effect at the time (see
// AcademySubscription.pricePerPlayerSnapshot / PlatformInvoice.pricePerPlayer).
model PlatformPricing {
  id             String   @id @default("default")
  pricePerPlayer Decimal  @db.Decimal(10, 2)
  // One-time fee charged during self-serve signup, before the academy account
  // is created (see PlatformAdminService#initializeSignupPayment) — separate
  // from pricePerPlayer, which is the recurring per-player subscription rate.
  signupFee      Decimal  @default(0) @db.Decimal(10, 2)
  currency       String   @default("GHS")
  updatedAt      DateTime @updatedAt

  @@map("platform_pricing")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
}

// SAMS's own billing relationship with one academy (what the academy owes
// SAMS for the platform itself) — a different thing entirely from that
// academy's own Paystack account in AcademySettings, which collects fees from
// its parents. Not tenant-scoped/RLS-protected (see AcademySettings' note):
// its primary key already is the academy id, and only the platform-billing
// module and the academy's own /billing/* routes ever touch it, always
// filtered by an explicit academyId rather than relying on RLS.
model AcademySubscription {
  academyId String             @id
  academy   Academy            @relation(fields: [academyId], references: [id], onDelete: Cascade)
  status    SubscriptionStatus @default(ACTIVE)

  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  pricePerPlayerSnapshot Decimal  @db.Decimal(10, 2)

  // A Paystack card authorization, captured the first time the academy pays —
  // reused every period via /transaction/charge_authorization for a genuinely
  // automatic recurring charge. Paystack's recurring-charge guarantee only
  // covers cards (not mobile money), so a momo-paying academy may still need
  // to pay manually each period; the cron below degrades to PAST_DUE either
  // way rather than assuming success.
  paystackAuthorizationCode  String?
  paystackAuthorizationEmail String?
  paystackCardType           String?
  paystackCardLast4          String?

  // Set once per period the first time the 5-day warning goes out, so the
  // daily cron doesn't re-send it every day until the period actually rolls over.
  lastWarningSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices PlatformInvoice[]

  @@map("academy_subscriptions")
}

enum PlatformInvoiceStatus {
  PENDING
  PAID
  FAILED
}

// One row per billing period per academy — SAMS's own revenue record,
// distinct from that academy's Invoice model (which bills its own parents).
model PlatformInvoice {
  id           String              @id @default(uuid())
  academyId    String
  subscription AcademySubscription @relation(fields: [academyId], references: [academyId], onDelete: Cascade)

  periodStart       DateTime
  periodEnd         DateTime
  activePlayerCount Int
  pricePerPlayer    Decimal               @db.Decimal(10, 2)
  amount            Decimal               @db.Decimal(10, 2)
  status            PlatformInvoiceStatus @default(PENDING)
  paidAt            DateTime?
  paystackReference String?
  failureReason     String?
  createdAt         DateTime              @default(now())

  @@index([academyId])
  @@map("platform_invoices")
}

// ============================================================
// Academy Structure
// ============================================================

model Season {
  id        String   @id @default(uuid())
  academyId String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  branchId  String?
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id])
  teams   Team[]

  @@index([branchId])
  @@index([academyId])
  @@map("seasons")
}

model AgeCategory {
  id        String   @id @default(uuid())
  academyId String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  branchId  String?
  name      String
  code      String
  minAge    Int
  maxAge    Int
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy             Academy                 @relation(fields: [academyId], references: [id])
  teams               Team[]
  players             Player[]
  feeStructures       FeeStructure[]
  assessmentTemplates AssessmentTemplate[]
  groupAssignments    PlayerGroupAssignment[]

  @@unique([academyId, code])
  @@index([branchId])
  @@index([academyId])
  @@map("age_categories")
}

model Team {
  id            String   @id @default(uuid())
  academyId     String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  branchId      String?
  name          String
  ageCategoryId String
  seasonId      String
  headCoachId   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  academy     Academy     @relation(fields: [academyId], references: [id])
  ageCategory AgeCategory @relation(fields: [ageCategoryId], references: [id])
  season      Season      @relation(fields: [seasonId], references: [id])
  headCoach   Coach?      @relation(fields: [headCoachId], references: [id])

  trainingGroups        TrainingGroup[]
  players               Player[]
  feeStructures         FeeStructure[]
  coachAssignments      CoachAssignment[]
  trainingPlans         TrainingPlan[]
  trainingSessions      TrainingSession[]
  matches               Match[]
  groupAssignments      PlayerGroupAssignment[]
  playerOfTheWeekAwards PlayerOfTheWeek[]

  @@index([branchId])
  @@index([ageCategoryId])
  @@index([seasonId])
  @@index([academyId])
  @@map("teams")
}

model TrainingGroup {
  id             String   @id @default(uuid())
  academyId      String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  branchId       String?
  name           String
  teamId         String
  primaryCoachId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academy      Academy @relation(fields: [academyId], references: [id])
  team         Team    @relation(fields: [teamId], references: [id])
  primaryCoach Coach?  @relation(fields: [primaryCoachId], references: [id])

  players          Player[]
  coachAssignments CoachAssignment[]
  trainingPlans    TrainingPlan[]
  trainingSessions TrainingSession[]
  groupAssignments PlayerGroupAssignment[]

  @@index([teamId])
  @@index([branchId])
  @@index([academyId])
  @@map("training_groups")
}

// ============================================================
// Player Management
// ============================================================

model Player {
  id                    String        @id @default(uuid())
  academyId             String        @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  playerCode            String?
  firstName             String
  middleName            String?
  lastName              String
  dateOfBirth           DateTime
  gender                Gender
  nationality           String?
  photoDocumentId       String?
  residentialAddress    String?
  medicalNotes          String?
  previousExperience    String?
  preferredPosition     String?
  dominantFoot          DominantFoot?
  emergencyContactName  String?
  emergencyContactPhone String?
  status                PlayerStatus  @default(DRAFT)
  ageCategoryId         String?
  teamId                String?
  trainingGroupId       String?
  primaryCoachId        String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  academy       Academy        @relation(fields: [academyId], references: [id])
  ageCategory   AgeCategory?   @relation(fields: [ageCategoryId], references: [id])
  team          Team?          @relation(fields: [teamId], references: [id])
  trainingGroup TrainingGroup? @relation(fields: [trainingGroupId], references: [id])
  primaryCoach  Coach?         @relation(fields: [primaryCoachId], references: [id])
  photo         Document?      @relation(fields: [photoDocumentId], references: [id])

  guardians             PlayerGuardian[]
  registrations         PlayerRegistration[]
  groupAssignments      PlayerGroupAssignment[]
  invoices              Invoice[]
  payments              Payment[]
  financialAdjustments  FinancialAdjustment[]
  trainingAttendance    TrainingAttendance[]
  assessments           PlayerAssessment[]
  coachRemarks          CoachRemark[]
  matchParticipations   MatchParticipation[]
  matchAssessments      MatchPlayerAssessment[]
  coachFeedback         CoachFeedback[]
  merchandiseOrders     MerchandiseOrder[]
  activityMarks         TrainingActivityMark[]
  playerOfTheWeekAwards PlayerOfTheWeek[]

  @@unique([academyId, playerCode])
  @@index([status])
  @@index([ageCategoryId])
  @@index([teamId])
  @@index([academyId])
  @@map("players")
}

model Guardian {
  id        String    @id @default(uuid())
  academyId String    @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  userId    String?   @unique
  firstName String
  lastName  String
  phone     String
  email     String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  academy           Academy            @relation(fields: [academyId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])
  players           PlayerGuardian[]
  issues            ParentIssue[]
  merchandiseOrders MerchandiseOrder[]

  @@index([academyId])
  @@map("guardians")
}

model PlayerGuardian {
  id           String               @id @default(uuid())
  academyId    String               @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  playerId     String
  guardianId   String
  relationship GuardianRelationship
  isPrimary    Boolean              @default(false)
  createdAt    DateTime             @default(now())

  academy  Academy  @relation(fields: [academyId], references: [id])
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([playerId, guardianId])
  @@index([academyId])
  @@map("player_guardians")
}

model PlayerRegistration {
  id                       String       @id @default(uuid())
  academyId                String       @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  playerId                 String
  status                   PlayerStatus @default(DRAFT)
  invitationToken          String?      @unique
  invitedByUserId          String?
  submittedAt              DateTime?
  reviewedByUserId         String?
  reviewedAt               DateTime?
  reviewNotes              String?
  registrationFeeInvoiceId String?      @unique
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  academy                Academy  @relation(fields: [academyId], references: [id])
  player                 Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  registrationFeeInvoice Invoice? @relation(fields: [registrationFeeInvoiceId], references: [id])

  @@index([playerId])
  @@index([status])
  @@index([academyId])
  @@map("player_registrations")
}

model PlayerGroupAssignment {
  id              String    @id @default(uuid())
  academyId       String    @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  playerId        String
  ageCategoryId   String?
  teamId          String?
  trainingGroupId String?
  coachId         String?
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?
  createdAt       DateTime  @default(now())

  academy       Academy        @relation(fields: [academyId], references: [id])
  player        Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  ageCategory   AgeCategory?   @relation(fields: [ageCategoryId], references: [id])
  team          Team?          @relation(fields: [teamId], references: [id])
  trainingGroup TrainingGroup? @relation(fields: [trainingGroupId], references: [id])
  coach         Coach?         @relation(fields: [coachId], references: [id])

  @@index([playerId])
  @@index([academyId])
  @@map("player_group_assignments")
}

// ============================================================
// Finance
// ============================================================

// A chargeable Fee (Registration, Monthly Subscription, a specific Levy, ...).
// Its amount is never typed directly — it's always the sum of the FeeItems
// attached via FeeTypeItem, recomputed whenever that composition changes.
model FeeType {
  id                String   @id @default(uuid())
  academyId         String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  name              String
  // The one piece of what used to be "category" with real behavior attached:
  // at most one can be both this and active (see
  // FinanceService#deactivateOtherRegistrationFeeTypes) — that's the fee a
  // new player's registration invoice is created from.
  isRegistrationFee Boolean  @default(false)
  description       String?
  isRecurring       Boolean  @default(false)
  defaultAmount     Decimal  @default(0) @db.Decimal(10, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  academy       Academy        @relation(fields: [academyId], references: [id])
  feeStructures FeeStructure[]
  invoices      Invoice[]
  items         FeeTypeItem[]

  @@index([academyId])
  @@map("fee_types")
}

// A raw priced building block (Jersey, Training Kit, Admin Processing, ...).
// Has no category of its own — it only becomes part of a chargeable Fee once
// attached to a FeeType, which is what prevents a plain item from accidentally
// becoming "the" Registration fee (or any other single-active fee) by itself.
model FeeItem {
  id          String   @id @default(uuid())
  academyId   String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academy  Academy       @relation(fields: [academyId], references: [id])
  feeTypes FeeTypeItem[]

  @@index([academyId])
  @@map("fee_items")
}

// The amount lives here, not on FeeItem — a raw item (e.g. "Jersey") has no
// price of its own; the price is only decided when it's attached to a
// specific Fee on the Billing page, which is what actually charges players.
model FeeTypeItem {
  academyId String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  feeTypeId String
  feeItemId String
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  // Bumped automatically on every write (attach or re-price) — the "date the
  // amount was set", with no extra code needed at each call site.
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id])
  feeType FeeType @relation(fields: [feeTypeId], references: [id], onDelete: Cascade)
  feeItem FeeItem @relation(fields: [feeItemId], references: [id], onDelete: Restrict)

  @@id([feeTypeId, feeItemId])
  @@index([academyId])
  @@map("fee_type_items")
}

model FeeStructure {
  id                String    @id @default(uuid())
  academyId         String    @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  feeTypeId         String
  ageCategoryId     String?
  teamId            String?
  amount            Decimal   @db.Decimal(10, 2)
  billingDayOfMonth Int?
  gracePeriodDays   Int       @default(0)
  effectiveFrom     DateTime  @default(now())
  effectiveTo       DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  academy     Academy      @relation(fields: [academyId], references: [id])
  feeType     FeeType      @relation(fields: [feeTypeId], references: [id])
  ageCategory AgeCategory? @relation(fields: [ageCategoryId], references: [id])
  team        Team?        @relation(fields: [teamId], references: [id])

  @@index([feeTypeId])
  @@index([academyId])
  @@map("fee_structures")
}

model Invoice {
  id              String        @id @default(uuid())
  academyId       String        @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  invoiceNumber   String        @unique
  playerId        String
  feeTypeId       String
  description     String?
  amount          Decimal       @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)
  dueDate         DateTime
  gracePeriodDays Int           @default(0)
  status          InvoiceStatus @default(PENDING)
  issuedAt        DateTime      @default(now())
  waivedAt        DateTime?
  waivedReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  academy Academy @relation(fields: [academyId], references: [id])
  player  Player  @relation(fields: [playerId], references: [id])
  feeType FeeType @relation(fields: [feeTypeId], references: [id])

  allocations          PaymentAllocation[]
  financialAdjustments FinancialAdjustment[]
  registration         PlayerRegistration?
  merchandiseOrder     MerchandiseOrder?

  @@index([playerId])
  @@index([status])
  @@index([dueDate])
  @@index([academyId])
  @@map("invoices")
}

model Payment {
  id               String        @id @default(uuid())
  academyId        String        @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  receiptNumber    String        @unique
  playerId         String
  amount           Decimal       @db.Decimal(10, 2)
  method           PaymentMethod
  reference        String?
  status           PaymentStatus @default(COMPLETED)
  receivedByUserId String
  reversedByUserId String?
  reversedAt       DateTime?
  reversalReason   String?
  paidAt           DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  academy     Academy             @relation(fields: [academyId], references: [id])
  player      Player              @relation(fields: [playerId], references: [id])
  allocations PaymentAllocation[]

  @@index([playerId])
  @@index([status])
  @@index([academyId])
  @@map("payments")
}

model PaymentAllocation {
  id        String   @id @default(uuid())
  academyId String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  paymentId String
  invoiceId String
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  academy Academy @relation(fields: [academyId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
  @@index([academyId])
  @@map("payment_allocations")
}

model FinancialAdjustment {
  id               String         @id @default(uuid())
  academyId        String         @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  playerId         String
  invoiceId        String?
  type             AdjustmentType
  amount           Decimal        @db.Decimal(10, 2)
  reason           String
  approvedByUserId String
  createdAt        DateTime       @default(now())

  academy Academy  @relation(fields: [academyId], references: [id])
  player  Player   @relation(fields: [playerId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([playerId])
  @@index([academyId])
  @@map("financial_adjustments")
}

// ============================================================
// Coaching
// ============================================================

model Coach {
  id         String    @id @default(uuid())
  academyId  String    @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  userId     String?   @unique
  firstName  String
  middleName String?
  lastName   String
  phone      String?
  email      String?
  bio        String?
  role       StaffRole @default(COACH)
  isActive   Boolean   @default(true)
