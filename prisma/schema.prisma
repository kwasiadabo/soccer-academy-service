  issueDate   DateTime?
  expiryDate  DateTime?
  documentId  String?
  createdAt   DateTime  @default(now())

  academy  Academy   @relation(fields: [academyId], references: [id])
  coach    Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id])

  @@index([coachId])
  @@index([academyId])
  @@map("coach_qualifications")
}

// ============================================================
// Training
// ============================================================

model TrainingPlan {
  id                 String                 @id @default(uuid())
  academyId          String                 @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  coachId            String
  teamId             String
  trainingGroupId    String?
  title              String
  objectives         String?
  scheduledDate      DateTime
  scheduledStart     String?
  scheduledEnd       String?
  location           String?
  requiredEquipment  String?
  skillsFocus        String?
  assessmentCriteria String?
  approvalStatus     TrainingApprovalStatus @default(DRAFT)
  version            Int                    @default(1)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  academy       Academy        @relation(fields: [academyId], references: [id])
  coach         Coach          @relation(fields: [coachId], references: [id])
  team          Team           @relation(fields: [teamId], references: [id])
  trainingGroup TrainingGroup? @relation(fields: [trainingGroupId], references: [id])

  activities TrainingActivity[]
  approvals  TrainingApproval[]
  sessions   TrainingSession[]

  @@index([coachId])
  @@index([teamId])
  @@index([approvalStatus])
  @@index([academyId])
  @@map("training_plans")
}

model TrainingActivity {
  id              String  @id @default(uuid())
  academyId       String  @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  trainingPlanId  String
  name            String
  description     String?
  durationMinutes Int?
  skillsDeveloped String?
  sortOrder       Int     @default(0)

  academy      Academy                @relation(fields: [academyId], references: [id])
  trainingPlan TrainingPlan           @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  marks        TrainingActivityMark[]

  @@index([trainingPlanId])
  @@index([academyId])
  @@map("training_activities")
}

// A coach's per-drill mark for one player — distinct from PlayerAssessment (which rates a
// whole session/match against a reusable rubric): this is one simple 1-10 score tied to a
// single TrainingActivity, meant to be quick to record right after running that drill.
model TrainingActivityMark {
  id                 String   @id @default(uuid())
  academyId          String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  trainingActivityId String
  playerId           String
  ratedByCoachId     String
  rating             Int
  remarks            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  academy          Academy          @relation(fields: [academyId], references: [id])
  trainingActivity TrainingActivity @relation(fields: [trainingActivityId], references: [id], onDelete: Cascade)
  player           Player           @relation(fields: [playerId], references: [id])
  ratedByCoach     Coach            @relation(fields: [ratedByCoachId], references: [id])

  @@unique([trainingActivityId, playerId])
  @@index([playerId])
  @@index([ratedByCoachId])
  @@index([academyId])
  @@map("training_activity_marks")
}

model TrainingApproval {
  id                String                 @id @default(uuid())
  academyId         String                 @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  trainingPlanId    String
  submittedByUserId String
  submittedAt       DateTime               @default(now())
  reviewedByUserId  String?
  reviewedAt        DateTime?
  decision          TrainingApprovalStatus @default(SUBMITTED)
  comments          String?

  academy      Academy      @relation(fields: [academyId], references: [id])
  trainingPlan TrainingPlan @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)

  @@index([trainingPlanId])
  @@index([academyId])
  @@map("training_approvals")
}

model TrainingSession {
  id                 String                @id @default(uuid())
  academyId          String                @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  trainingPlanId     String?
  teamId             String
  trainingGroupId    String?
  // Nullable: recurring Saturday sessions are auto-provisioned as a shared team fixture
  // (see TrainingService#getOrCreateSaturdaySession) rather than personally scheduled by
  // one coach, so there's often no single "creator" to attribute it to.
  conductedByCoachId String?
  date               DateTime
  startTime          String?
  endTime            String?
  location           String?
  status             TrainingSessionStatus @default(SCHEDULED)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  academy          Academy        @relation(fields: [academyId], references: [id])
  trainingPlan     TrainingPlan?  @relation(fields: [trainingPlanId], references: [id])
  team             Team           @relation(fields: [teamId], references: [id])
  trainingGroup    TrainingGroup? @relation(fields: [trainingGroupId], references: [id])
  conductedByCoach Coach?         @relation(fields: [conductedByCoachId], references: [id])

  attendance        TrainingAttendance[]
  assessments       PlayerAssessment[]
  sessionActivities TrainingSessionActivity[]
  playerOfTheWeek   PlayerOfTheWeek?

  @@index([teamId])
  @@index([date])
  @@index([academyId])
  @@map("training_sessions")
}

// One pick per team per Saturday session — the player with the highest average
// TrainingActivityMark rating from that week's training, computed automatically
// by TrainingService's Saturday cron. Surfaced publicly on the marketing site and
// starred for the guardian in the parent portal.
model PlayerOfTheWeek {
  id                String   @id @default(uuid())
  academyId         String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  playerId          String
  teamId            String
  trainingSessionId String   @unique
  weekOf            DateTime
  averageRating     Decimal  @db.Decimal(4, 2)
  createdAt         DateTime @default(now())

  academy         Academy         @relation(fields: [academyId], references: [id])
  player          Player          @relation(fields: [playerId], references: [id])
  team            Team            @relation(fields: [teamId], references: [id])
  trainingSession TrainingSession @relation(fields: [trainingSessionId], references: [id])

  @@index([playerId])
  @@index([teamId])
  @@index([weekOf])
  @@index([academyId])
  @@map("player_of_the_week")
}

enum GalleryPhotoContext {
  SATURDAY_TRAINING
  MATCH
}

// Publicly-displayed marketing photos. Every new batch upload for a given context
// replaces the previous one outright (old rows deleted, old Cloudinary assets
// removed) — see GalleryService#replaceForContext — so this is always "the current
// set of photos," never an accumulating history.
model GalleryPhoto {
  id               String              @id @default(uuid())
  academyId        String              @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  context          GalleryPhotoContext
  // Opaque key into StorageService (Cloudinary in production) — resolved to a public
  // delivery URL on read via StorageService#resolvePath, and passed to
  // StorageService#delete to remove the asset when this batch is replaced.
  storageKey       String
  sortOrder        Int                 @default(0)
  // Every photo in a batch shares the same session details, entered once at upload
  // time (see GalleryService#replaceForContext) — the date of the Saturday session
  // or match, and a short description (e.g. "vs Rangers FC — Home win 3-1").
  sessionDate      DateTime
  details          String
  uploadedByUserId String
  createdAt        DateTime            @default(now())

  academy        Academy @relation(fields: [academyId], references: [id])
  uploadedByUser User    @relation(fields: [uploadedByUserId], references: [id])

  @@index([context])
  @@index([academyId])
  @@map("gallery_photos")
}

model TrainingSessionActivity {
  id                String   @id @default(uuid())
  academyId         String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  trainingSessionId String
  name              String
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  academy         Academy            @relation(fields: [academyId], references: [id])
  trainingSession TrainingSession    @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  ratings         AssessmentRating[]

  @@index([trainingSessionId])
  @@index([academyId])
  @@map("training_session_activities")
}

model TrainingAttendance {
  id                String           @id @default(uuid())
  academyId         String           @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  trainingSessionId String
  playerId          String
  status            AttendanceStatus
  remarks           String?
  recordedByUserId  String
  // Always re-stamped to the current time on every mark or re-mark (see
  // TrainingService#recordAttendance) — this is a "when was it recorded" audit
  // field, not just a creation timestamp.
  recordedAt        DateTime         @default(now())

  academy         Academy         @relation(fields: [academyId], references: [id])
  trainingSession TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  player          Player          @relation(fields: [playerId], references: [id])
  recordedByUser  User            @relation("TrainingAttendanceRecorder", fields: [recordedByUserId], references: [id])

  @@unique([trainingSessionId, playerId])
  @@index([playerId])
  @@index([academyId])
  @@map("training_attendance")
}

// ============================================================
// Assessments
// ============================================================

model AssessmentTemplate {
  id            String          @id @default(uuid())
  academyId     String          @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  name          String
  ageCategoryId String?
  ratingScale   RatingScaleType @default(SCALE_1_5)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  academy     Academy      @relation(fields: [academyId], references: [id])
  ageCategory AgeCategory? @relation(fields: [ageCategoryId], references: [id])

  criteria    AssessmentCriteria[]
  assessments PlayerAssessment[]

  @@index([academyId])
  @@map("assessment_templates")
}

model AssessmentCriteria {
  id          String             @id @default(uuid())
  academyId   String             @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  templateId  String
  category    AssessmentCategory
  name        String
  description String?
  sortOrder   Int                @default(0)

  academy  Academy            @relation(fields: [academyId], references: [id])
  template AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ratings  AssessmentRating[]

  @@index([templateId])
  @@index([academyId])
  @@map("assessment_criteria")
}

model PlayerAssessment {
  id                  String    @id @default(uuid())
  academyId           String    @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  playerId            String
  // Nullable: a session-scoped assessment rates a coach's ad hoc session activities
  // instead of a pre-built template (see TrainingSessionActivity / AssessmentsService#createAssessment).
  templateId          String?
  trainingSessionId   String?
  matchId             String?
  assessedByCoachId   String
  assessmentDate      DateTime  @default(now())
  strengths           String?
  areasForImprovement String?
  developmentGoals    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  academy         Academy             @relation(fields: [academyId], references: [id])
  player          Player              @relation(fields: [playerId], references: [id])
  template        AssessmentTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  trainingSession TrainingSession?    @relation(fields: [trainingSessionId], references: [id])
  match           Match?              @relation(fields: [matchId], references: [id])
  assessedByCoach Coach               @relation(fields: [assessedByCoachId], references: [id])

  ratings AssessmentRating[]

  @@index([playerId])
  @@index([assessmentDate])
  @@index([academyId])
  @@map("player_assessments")
}

model AssessmentRating {
  id                 String  @id @default(uuid())
  academyId          String  @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  playerAssessmentId String
  // Exactly one of criteriaId/sessionActivityId is set, depending on whether the parent
  // PlayerAssessment used a template (criteriaId) or a session's set activities
  // (sessionActivityId) — enforced in AssessmentsService#createAssessment.
  criteriaId         String?
  sessionActivityId  String?
  ratingValue        Decimal @db.Decimal(5, 2)
  ratingLabel        String?
  remarks            String?

  academy          Academy                  @relation(fields: [academyId], references: [id])
  playerAssessment PlayerAssessment         @relation(fields: [playerAssessmentId], references: [id], onDelete: Cascade)
  criteria         AssessmentCriteria?      @relation(fields: [criteriaId], references: [id], onDelete: Restrict)
  sessionActivity  TrainingSessionActivity? @relation(fields: [sessionActivityId], references: [id], onDelete: Restrict)

  @@unique([playerAssessmentId, criteriaId])
  @@unique([playerAssessmentId, sessionActivityId])
  @@index([academyId])
  @@map("assessment_ratings")
}

model CoachRemark {
  id        String   @id @default(uuid())
  academyId String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  playerId  String
  coachId   String
  remark    String
  context   String?
  createdAt DateTime @default(now())

  academy Academy @relation(fields: [academyId], references: [id])
  player  Player  @relation(fields: [playerId], references: [id])
  coach   Coach   @relation(fields: [coachId], references: [id])

  @@index([playerId])
  @@index([academyId])
  @@map("coach_remarks")
}

// ============================================================
// Matches
// ============================================================

model Opponent {
  id          String   @id @default(uuid())
  academyId   String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  name        String
  contactInfo String?
  createdAt   DateTime @default(now())

  academy Academy @relation(fields: [academyId], references: [id])
  matches Match[]

  @@index([academyId])
  @@map("opponents")
}

model Match {
  id              String      @id @default(uuid())
  academyId       String      @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  teamId          String
  opponentId      String
  competitionName String?
  venue           String?
  matchDate       DateTime
  status          MatchStatus @default(SCHEDULED)
  homeScore       Int?
  awayScore       Int?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  academy  Academy  @relation(fields: [academyId], references: [id])
  team     Team     @relation(fields: [teamId], references: [id])
  opponent Opponent @relation(fields: [opponentId], references: [id])

  participations         MatchParticipation[]
  matchPlayerAssessments MatchPlayerAssessment[]
  developmentAssessments PlayerAssessment[]

  @@index([teamId])
  @@index([matchDate])
  @@index([academyId])
  @@map("matches")
}

model MatchParticipation {
  id             String  @id @default(uuid())
  academyId      String  @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  matchId        String
  playerId       String
  isStarting     Boolean @default(false)
  isSubstitute   Boolean @default(false)
  positionPlayed String?
  minutesPlayed  Int?

  academy Academy @relation(fields: [academyId], references: [id])
  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player  Player  @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
  @@index([academyId])
  @@map("match_participations")
}

model MatchPlayerAssessment {
  id                     String   @id @default(uuid())
  academyId              String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  matchId                String
  playerId               String
  assessedByCoachId      String
  technicalRating        Decimal? @db.Decimal(5, 2)
  tacticalRating         Decimal? @db.Decimal(5, 2)
  teamContributionRating Decimal? @db.Decimal(5, 2)
  disciplineRating       Decimal? @db.Decimal(5, 2)
  effortRating           Decimal? @db.Decimal(5, 2)
  overallRating          Decimal? @db.Decimal(5, 2)
  remarks                String?
  recommendations        String?
  createdAt              DateTime @default(now())

  academy         Academy @relation(fields: [academyId], references: [id])
  match           Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player          Player  @relation(fields: [playerId], references: [id])
  assessedByCoach Coach   @relation(fields: [assessedByCoachId], references: [id])

  @@unique([matchId, playerId])
  @@index([academyId])
  @@map("match_player_assessments")
}

// ============================================================
// Coach Feedback (from parents)
// ============================================================

model CoachFeedback {
  id                String   @id @default(uuid())
  academyId         String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  coachId           String
  submittedByUserId String
  playerId          String
  period            String?
  overallRating     Decimal  @db.Decimal(3, 2)
  isAnonymous       Boolean  @default(false)
  comments          String?
  createdAt         DateTime @default(now())

  academy         Academy @relation(fields: [academyId], references: [id])
  coach           Coach   @relation(fields: [coachId], references: [id])
  submittedByUser User    @relation(fields: [submittedByUserId], references: [id])
  player          Player  @relation(fields: [playerId], references: [id])

  criteria CoachFeedbackCriteria[]

  @@unique([coachId, submittedByUserId, playerId, period])
  @@index([coachId])
  @@index([academyId])
  @@map("coach_feedback")
}

model CoachFeedbackCriteria {
  id            String  @id @default(uuid())
  academyId     String  @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  feedbackId    String
  criterionName String
  rating        Decimal @db.Decimal(3, 2)

  academy  Academy       @relation(fields: [academyId], references: [id])
  feedback CoachFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@index([academyId])
  @@map("coach_feedback_criteria")
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// A parent-raised issue/complaint, with a threaded conversation (IssueMessage) between
// the guardian and academy staff (Admin, Receptionist, Head Coach — gated by
// PERMISSIONS.ISSUES_MANAGE).
model ParentIssue {
  id                String      @id @default(uuid())
  academyId         String      @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  guardianId        String
  submittedByUserId String
  subject           String
  description       String
  status            IssueStatus @default(OPEN)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  academy     Academy        @relation(fields: [academyId], references: [id])
  guardian    Guardian       @relation(fields: [guardianId], references: [id])
  submittedBy User           @relation("IssueSubmitter", fields: [submittedByUserId], references: [id])
  messages    IssueMessage[]

  @@index([guardianId])
  @@index([academyId])
  @@map("parent_issues")
}

model IssueMessage {
  id           String    @id @default(uuid())
  academyId    String    @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  issueId      String
  authorUserId String
  isStaffReply Boolean
  message      String
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  academy Academy     @relation(fields: [academyId], references: [id])
  issue   ParentIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author  User        @relation("IssueMessageAuthor", fields: [authorUserId], references: [id])

  @@index([issueId])
  @@index([academyId])
  @@map("issue_messages")
}

// ============================================================
// Merchandise
// ============================================================

enum ProductCategory {
  JERSEY
  TRACK_SUIT
  BOOTS
  SOCKS
  OTHER
}

enum MerchandiseOrderStatus {
  PENDING
  APPROVED
  READY_FOR_PICKUP
  FULFILLED
  REJECTED
  CANCELLED
}

model Product {
  id          String          @id @default(uuid())
  academyId   String          @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  name        String
  description String?
  category    ProductCategory
  basePrice   Decimal         @db.Decimal(10, 2)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  academy  Academy          @relation(fields: [academyId], references: [id])
  images   ProductImage[]
  variants ProductVariant[]

  @@index([category])
  @@index([isActive])
  @@index([academyId])
  @@map("products")
}

// A photo of a Product — a product can carry several (front/back/detail shots) so the
// shop can show "different sides" of the merchandise; sortOrder[0] is the cover image
// used in catalog grids.
model ProductImage {
  id         String   @id @default(uuid())
  academyId  String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  productId  String
  documentId String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  academy  Academy  @relation(fields: [academyId], references: [id])
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id])

  @@index([productId])
  @@index([academyId])
  @@map("product_images")
}

// One purchasable size/variant of a Product (S/M/L, boot size, "One Size").
// priceOverride lets one size cost more than basePrice (e.g. XXL); null falls
// back to Product.basePrice.
model ProductVariant {
  id            String   @id @default(uuid())
  academyId     String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  productId     String
  sizeLabel     String
  priceOverride Decimal? @db.Decimal(10, 2)
  stockQuantity Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  academy    Academy                @relation(fields: [academyId], references: [id])
  product    Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems MerchandiseOrderItem[]

  @@unique([productId, sizeLabel])
  @@index([productId])
  @@index([academyId])
  @@map("product_variants")
}

// A parent's request to buy merchandise for one child. Submission is gated by
// PARENT_PORTAL_ACCESS (via GuardianContextService.assertOwnsPlayer, same as
// ParentIssue); staff fulfillment is gated by PERMISSIONS.ORDERS_MANAGE.
// Approving generates an Invoice so payment flows through the existing
// in-person collection UI.
model MerchandiseOrder {
  id                String                 @id @default(uuid())
  academyId         String                 @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  guardianId        String
  // Null for a guest checkout placed from the public store without logging in —
  // the guest's own contact details are captured in the guest* fields below instead.
  submittedByUserId String?
  // Populated only for a guest (unauthenticated) checkout — who to reach about
  // this order when there's no linked User account to fall back on.
  guestName         String?
  guestPhone        String?
  guestEmail        String?
  playerId          String
  status            MerchandiseOrderStatus @default(PENDING)
  totalAmount       Decimal                @db.Decimal(10, 2)
  invoiceId         String?                @unique
  staffNotes        String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  academy     Academy  @relation(fields: [academyId], references: [id])
  guardian    Guardian @relation(fields: [guardianId], references: [id])
  submittedBy User?    @relation("MerchandiseOrderSubmitter", fields: [submittedByUserId], references: [id])
  player      Player   @relation(fields: [playerId], references: [id])
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])

  items MerchandiseOrderItem[]

  @@index([guardianId])
  @@index([playerId])
  @@index([status])
  @@index([academyId])
  @@map("merchandise_orders")
}

model MerchandiseOrderItem {
  id               String   @id @default(uuid())
  academyId        String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  orderId          String
  productVariantId String
  quantity         Int
  unitPriceAtOrder Decimal  @db.Decimal(10, 2)
  lineTotal        Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())

  academy        Academy          @relation(fields: [academyId], references: [id])
  order          MerchandiseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant   @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@index([productVariantId])
  @@index([academyId])
  @@map("merchandise_order_items")
}

// ============================================================
// System
// ============================================================

model Notification {
  id                String              @id @default(uuid())
  academyId         String              @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  userId            String
  channel           NotificationChannel
  title             String
  body              String
  status            NotificationStatus  @default(PENDING)
  relatedEntityType String?
  relatedEntityId   String?
  sentAt            DateTime?
  readAt            DateTime?
  createdAt         DateTime            @default(now())

  academy Academy @relation(fields: [academyId], references: [id])
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([academyId])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid())
  academyId   String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  beforeData  Json?
  afterData   Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  academy   Academy @relation(fields: [academyId], references: [id])
  actorUser User?   @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([academyId])
  @@map("audit_logs")
}

model Document {
  id               String            @id @default(uuid())
  academyId        String            @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  ownerType        DocumentOwnerType
  ownerId          String
  documentType     DocumentType
  fileName         String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String
  createdAt        DateTime          @default(now())

  academy        Academy @relation(fields: [academyId], references: [id])
  uploadedByUser User    @relation(fields: [uploadedByUserId], references: [id])

  players             Player[]
  coachQualifications CoachQualification[]
  productImages       ProductImage[]

  @@index([ownerType, ownerId])
  @@index([academyId])
  @@map("documents")
}

model ConfigurationSetting {
  id              String   @id @default(uuid())
  academyId       String   @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  key             String
  value           Json
  description     String?
  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id])

  @@unique([academyId, key])
  @@index([academyId])
  @@map("configuration_settings")
}

enum InquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

model PublicInquiry {
  id               String        @id @default(uuid())
  academyId        String        @default(dbgenerated("current_setting('app.current_academy_id'::text, true)"))
  childFirstName   String
  childLastName    String
  childDateOfBirth DateTime?
  guardianName     String
  guardianPhone    String
  guardianEmail    String?
  preferredProgram String?
  message          String?
  status           InquiryStatus @default(NEW)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  academy Academy @relation(fields: [academyId], references: [id])

  @@index([academyId])
  @@map("public_inquiries")
}

// ============================================================
// Platform administration
// ============================================================
//
// A platform operator's own login — deliberately outside the tenant model
// entirely: no academyId, no RBAC ties, not in TENANT_SCOPED_MODELS, no row-
// level-security policy. A platform credential must never be confused with,
// or interchangeable with, an academy User — enforced by giving it a
// completely separate JWT strategy/secret (see PlatformAdminJwtStrategy)
// rather than reusing the per-academy auth path.
model PlatformAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("platform_admins")
}

// A "bring your academy onto SAMS" lead from the platform's own public
// landing page — distinct from PublicInquiry (a parent asking about
// enrolling their child at one specific, already-onboarded academy).
// Not tenant-scoped: submitted before any academy exists for this lead.
model PlatformLead {
  id               String        @id @default(uuid())
  academyName      String
  trainingLocation String
  contactName      String
  contactEmail     String
  contactPhone     String?
  message          String?
  status           InquiryStatus @default(NEW)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("platform_leads")
}
