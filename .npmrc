# Pinned so `npm install` here always resolves the same way Docker's `npm ci`
# does. A machine-wide ~/.npmrc with legacy-peer-deps=true (or any other
# override) silently produces a package-lock.json that's missing packages
# only pulled in under strict peer-dep resolution — which then fails `npm ci`
# in the Docker build, since the image has no such override. See git history
# on package-lock.json for two prior incidents.
legacy-peer-deps=false
